<script>
// NAVIGASI HALAMAN
function go(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.navbtn').forEach(b=>
    b.classList.toggle('active',b.dataset.page===id));
  window.scrollTo({top:0,behavior:'smooth'});
}
document.querySelectorAll('.navbtn').forEach(b=>
  b.addEventListener('click',()=>go(b.dataset.page)));

// DATA BATIK
// Keterangan filosofi dapat berbeda menurut motif, sumber, dan tradisi setempat.
const batiks = {
"Sumatra":[
["Batik Besurek","Kota Bengkulu, Bengkulu","Besurek berkaitan dengan kata surat atau tulisan. Motif kaligrafi dan unsur alam mencerminkan pertemuan budaya Melayu dan pengaruh Islam. Makna bergantung pada motif; tulisan suci harus dihormati.","Batik tulis atau cap; sebagian produk modern dibuat dengan teknik cetak."],
["Batik Jambi Motif Angso Duo","Kota Jambi, Provinsi Jambi","Angso Duo berarti dua angsa. Motif ini dikaitkan dengan kebersamaan, kesetiaan, dan keharmonisan dalam ikon budaya Jambi.","Batik tulis atau cap dengan malam sebagai perintang warna."],
["Batik Tanah Liek","Wilayah Minangkabau, terutama Padang dan sekitarnya, Sumatera Barat","Tanah liek berarti tanah liat. Warna tanah dan ragam hias alam mengingatkan hubungan manusia dengan alam serta kearifan lokal.","Pewarnaan tradisional menggunakan tanah liat; teknik dapat berbeda antarperajin."]
],
"Jawa":[
["Batik Parang","Yogyakarta dan Surakarta","Parang dikaitkan dengan bentuk ombak atau bilah berulang yang diagonal. Susunannya sering melambangkan keteguhan, semangat, dan kesinambungan.","Batik tulis atau cap dengan teknik tutup-celup malam."],
["Batik Mega Mendung","Cirebon, Jawa Barat","Mega mendung berarti awan mendung. Bentuk awan berlapis mengajarkan ketenangan, kesabaran, dan kemampuan mengendalikan diri.","Batik tulis atau cap dengan proses pewarnaan berlapis."],
["Batik Kawung","Yogyakarta dan Surakarta","Kawung berupa lingkaran oval yang menyerupai irisan buah aren. Sering ditafsirkan sebagai lambang keseimbangan, pengendalian diri, dan kehidupan tertata.","Batik tulis atau cap memakai malam untuk menahan warna."]
],
"Kalimantan":[
["Sasirangan Motif Bayam Raja","Kalimantan Selatan, khususnya Banjarmasin dan wilayah budaya Banjar","Sasirangan berasal dari kata Banjar sirang yang berkaitan dengan menjelujur. Bayam Raja adalah nama motif; tafsir maknanya dapat berbeda menurut sumber dan perajin.","Teknik jelujur, ikat, dan celup sebagai perintang warna; bukan teknik canting malam."],
["Batik Benang Bintik","Palangka Raya dan wilayah budaya Dayak Ngaju, Kalimantan Tengah","Benang Bintik adalah nama kain bermotif khas Kalimantan Tengah. Motifnya dapat mengambil inspirasi dari simbol dan alam Dayak.","Batik kontemporer umumnya menggunakan teknik tulis, cap, atau cetak."],
["Motif Batang Garing pada Batik","Palangka Raya dan wilayah budaya Dayak Ngaju, Kalimantan Tengah","Batang Garing dikenal sebagai simbol pohon kehidupan dalam budaya Dayak Ngaju. Motif ini dapat menyimbolkan hubungan kehidupan, alam, dan keseimbangan.","Ragam hias lokal yang diterapkan pada kain melalui teknik batik tulis, cap, atau cetak."]
],
"Sulawesi":[
["Batik Toraja Motif Pa'tedong","Tana Toraja, Sulawesi Selatan","Pa'tedong merujuk pada kerbau dalam ragam hias Toraja. Kerbau memiliki kedudukan penting dalam adat dan upacara.","Motif terinspirasi ragam hias Toraja yang diterapkan pada batik modern."],
["Batik Lontara","Makassar dan wilayah budaya Bugis-Makassar, Sulawesi Selatan","Lontara adalah aksara tradisional Bugis-Makassar. Motif aksara mengingatkan pentingnya literasi, sejarah, dan pelestarian bahasa daerah.","Motif aksara diterapkan pada kain dengan teknik tulis, cap, atau cetak."],
["Batik Motif Pinisi","Bulukumba, Sulawesi Selatan","Pinisi adalah perahu tradisional yang terkait dengan pelaut Bugis-Makassar. Motif ini melambangkan keterampilan, keberanian, dan semangat menjelajah.","Batik kontemporer dengan teknik tulis, cap, atau cetak."]
],
"Bali + Nusa Tenggara":[
["Batik Bali Motif Merak","Gianyar dan sentra kerajinan batik di Bali","Merak menjadi lambang keindahan dan keanggunan dalam ragam hias. Motif batik Bali juga dapat terinspirasi dari alam dan ornamen lokal.","Batik tulis, cap, atau kombinasi teknik; proses berbeda menurut perajin."],
["Batik Sasambo","Mataram dan berbagai sentra kerajinan di Nusa Tenggara Barat","Sasambo merupakan singkatan dari Sasak, Samawa, dan Mbojo. Motifnya mengangkat identitas dan keragaman budaya NTB.","Batik tulis, cap, atau cetak; motif terinspirasi budaya lokal."],
["Batik Motif Komodo","Labuan Bajo dan wilayah Flores, Nusa Tenggara Timur","Komodo adalah satwa khas Nusa Tenggara Timur. Motifnya mengingatkan pentingnya menjaga satwa endemik dan lingkungan.","Batik kontemporer dengan teknik tulis, cap, atau cetak."]
],
"Papua":[
["Batik Port Numbay","Kota Jayapura, Papua","Port Numbay merupakan nama yang digunakan untuk Jayapura. Motifnya dapat mengangkat ikon pesisir, alam, dan budaya Papua.","Batik kontemporer dengan teknik tulis, cap, atau cetak."],
["Batik Motif Asmat","Wilayah budaya Asmat, Papua bagian selatan","Motif terinspirasi dari seni ukir Asmat yang berhubungan dengan leluhur dan kehidupan komunitas. Makna setiap bentuk mengikuti tradisi setempat.","Ragam hias Asmat diadaptasi pada kain batik modern."],
["Batik Motif Cenderawasih","Jayapura dan sentra kerajinan di Papua","Cenderawasih dikenal sebagai burung khas Papua. Motifnya melambangkan kekayaan alam dan mengajak masyarakat menjaga keanekaragaman hayati.","Batik kontemporer dengan teknik tulis, cap, atau cetak."]
]
};

const regions=Object.keys(batiks);
let currentRegion="Sumatra";

const regionIcons={
"Sumatra":"🌴","Jawa":"🏛️","Kalimantan":"🌳",
"Sulawesi":"⛵","Bali + Nusa Tenggara":"🌺","Papua":"🦜"
};
const regionBox=document.getElementById('regions');
regions.forEach(r=>{
  const b=document.createElement('button');
  b.className='region';b.innerHTML=regionIcons[r]+'<br>'+r;
  b.onclick=()=>selectRegion(r,b);
  regionBox.appendChild(b);
});

function selectRegion(region,button){
  currentRegion=region;
  document.querySelectorAll('.region').forEach(b=>b.classList.remove('selected'));
  if(button)button.classList.add('selected');
  document.getElementById('batikDetail').innerHTML='';
  const target=document.getElementById('batikChoices');
  target.innerHTML='<h2>Ragam Batik: '+region+'</h2>'+
    '<p class="muted">Pilih kartu untuk membaca penjelasan lengkap.</p>';
  const grid=document.createElement('div');grid.className='grid';
  batiks[region].forEach((item,i)=>{
    const card=document.createElement('article');card.className='card batik-card';
    card.innerHTML='<span class="pill">Batik '+(i+1)+'</span>'+
      '<div class="symbol">❋</div><h3>'+item[0]+'</h3>'+
      '<p class="muted">📍 '+item[1]+'</p>'+
      '<button class="primary">Pelajari motif →</button>';
    card.querySelector('button').onclick=()=>showBatik(item);
    grid.appendChild(card);
  });
  target.appendChild(grid);
}
function showBatik(item){
  const box=document.getElementById('batikDetail');
  box.innerHTML='<article class="card detail"><span class="pill">Ensiklopedia SENADA</span>'+
    '<h2>'+item[0]+'</h2><dl>'+
    '<dt>Nama batik</dt><dd>'+item[0]+'</dd>'+
    '<dt>Arti nama</dt><dd>'+item[2].split('.')[0]+'.</dd>'+
    '<dt>Asal daerah spesifik</dt><dd>'+item[1]+'</dd>'+
    '<dt>Filosofi motif</dt><dd>'+item[2]+'</dd>'+
    '<dt>Makna</dt><dd>'+item[2]+'</dd>'+
    '<dt>Teknik pembuatan</dt><dd>'+item[3]+'</dd>'+
    '</dl><button class="secondary" onclick="document.getElementById(\'batikChoices\').scrollIntoView({behavior:\'smooth\'})">← Pilih motif lain</button></article>';
  box.scrollIntoView({behavior:'smooth',block:'nearest'});
}
selectRegion("Sumatra",regionBox.firstElementChild);

// FASHION STYLE
const fashionData={
laki:[
["👔","Smart Casual","Kemeja batik bermotif kecil, celana chino krem, dan sepatu kasual. Cocok untuk acara sekolah atau keluarga."],
["👕","Streetwear","Kaos polos dengan outer batik, celana nyaman, dan sneakers. Pilih motif sebagai aksen."],
["🧥","Layering","Jaket atau overshirt batik dipadukan dengan kaos netral. Gunakan maksimal dua atau tiga warna utama."]
],
