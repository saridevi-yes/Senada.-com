// MINI GAMES
const quizzes=[
[
{q:"Batik Mega Mendung berasal dari daerah mana?",o:["Cirebon","Papua","Bali"],a:0,why:"Mega Mendung dikenal sebagai motif khas Cirebon, Jawa Barat."},
{q:"Apa yang digambarkan motif Kawung?",o:["Irisan buah aren","Burung cenderawasih","Perahu pinisi"],a:0,why:"Bentuk oval Kawung menyerupai irisan buah aren."},
{q:"Batik Besurek dari Bengkulu dikenal dengan motif apa?",o:["Kaligrafi","Awan berlapis","Kapal"],a:0,why:"Besurek dikenal dengan ragam hias kaligrafi dan unsur alam."}
],
[
{q:"Teknik batik tulis menggunakan alat utama berupa ...",o:["Canting","Jarum rajut","Palu"],a:0,why:"Canting digunakan untuk mengalirkan malam ke kain."},
{q:"Sasirangan berasal dari budaya masyarakat ...",o:["Banjar","Asmat","Toraja"],a:0,why:"Sasirangan merupakan kain tradisional masyarakat Banjar di Kalimantan Selatan."},
{q:"Motif Pinisi terinspirasi dari ...",o:["Perahu tradisional","Bunga melati","Gunung"],a:0,why:"Pinisi adalah perahu tradisional yang berkaitan dengan pelaut Bugis-Makassar."}
],
[
{q:"SENADA adalah singkatan dari ...",o:["Seni Nusantara dalam Batik","Sejarah Negara dan Adat","Sentra Nasional Daerah"],a:0,why:"SENADA berarti Seni Nusantara dalam Batik."},
{q:"Motif Cenderawasih mengingatkan kita pada kekayaan alam ...",o:["Papua","Jawa Barat","Sumatera Barat"],a:0,why:"Cenderawasih merupakan burung yang identik dengan Papua."},
{q:"Bahan perintang warna dalam batik tulis tradisional adalah ...",o:["Malam atau lilin batik","Pasir","Tepung"],a:0,why:"Malam menutup bagian kain agar tidak terkena warna saat pencelupan."}
]
];
let gameIndex=0,questionIndex=0,score=0,answered=false;
const gameNames=["Tebak Motif","Adu Cepat Batik","Rantai Budaya"];
function startGame(index){
  gameIndex=index;questionIndex=0;score=0;answered=false;
  renderQuestion();document.getElementById('gameArea').scrollIntoView({behavior:'smooth'});
}
function renderQuestion(){
  const area=document.getElementById('gameArea');
  const list=quizzes[gameIndex];
  if(questionIndex>=list.length){
    area.innerHTML='<article class="card"><span class="eyebrow">PERMAINAN SELESAI</span>'+
      '<h2>Hebat, Penjelajah Budaya! 🎉</h2><p>Skormu: <b>'+score+' dari '+list.length+'</b></p>'+
      '<p>'+ (score===list.length?'Sempurna! Kamu mengenal batik dengan baik.':'Terus belajar, lalu coba lagi untuk meningkatkan skormu!')+'</p>'+
      '<button class="primary" onclick="startGame('+gameIndex+')">Main Lagi</button> '+
      '<button class="secondary" onclick="document.getElementById(\'games\').scrollIntoView({behavior:\'smooth\'})">Pilih Permainan</button></article>';
    return;
  }
  answered=false;
  const q=list[questionIndex];
  area.innerHTML='<article class="card"><span class="pill">'+gameNames[gameIndex]+'</span>'+
    '<h3>Pertanyaan '+(questionIndex+1)+' dari '+list.length+'</h3>'+
    '<div class="progress"><span style="width:'+(questionIndex/list.length*100)+'%"></span></div>'+
    '<h2>'+q.q+'</h2><div id="options"></div>'+
    '<p id="feedback" class="feedback" aria-live="polite"></p>'+
    '<button id="next" class="primary" style="display:none" onclick="nextQuestion()">Pertanyaan Berikutnya →</button></article>';
  const options=document.getElementById('options');
  q.o.forEach((option,i)=>{
    const b=document.createElement('button');b.className='quiz-option';b.textContent=option;
    b.onclick=()=>answerQuestion(i);options.appendChild(b);
  });
}
function answerQuestion(choice){
  if(answered)return;
  answered=true;
  const q=quizzes[gameIndex][questionIndex];
  const buttons=document.querySelectorAll('.quiz-option');
  buttons.forEach((b,i)=>{b.disabled=true;if(i===q.a)b.style.borderColor='#64845B';});
  const feedback=document.getElementById('feedback');
  if(choice===q.a){score++;feedback.textContent='Benar! '+q.why;}
  else feedback.textContent='Belum tepat. '+q.why;
  document.getElementById('next').style.display='inline-block';
}
function nextQuestion(){questionIndex++;renderQuestion();}
</script>
