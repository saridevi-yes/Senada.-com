
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SENADA | Seni Nusantara dalam Batik</title>
<style>
:root {
  --green:#8FAF83;
  --dark:#38543B;
  --brown:#79543A;
  --cream:#F8F1E3;
  --white:#FFFCF5;
  --gold:#D6B77A;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--cream);color:#443B30;
  font-family:Arial,sans-serif;line-height:1.7
}
header{
  background:var(--white);padding:12px 6%;
  display:flex;align-items:center;justify-content:space-between;
  gap:15px;flex-wrap:wrap;position:sticky;top:0;z-index:10;
  box-shadow:0 2px 10px #59462a18
}
.brand{display:flex;align-items:center;gap:10px}
.logo{
  background:var(--dark);color:var(--cream);border-radius:50%;
  width:48px;height:48px;display:grid;place-items:center;
  font-size:25px;border:3px solid var(--gold)
}
.brand h2{margin:0;color:var(--dark);letter-spacing:3px}
.brand small{display:block;font-size:11px;color:var(--brown)}
nav{display:flex;gap:6px;flex-wrap:wrap}
button,.navbtn{
  cursor:pointer;border:0;border-radius:10px;padding:10px 15px;
  font-size:14px;font-weight:bold;transition:.2s
}
.navbtn{background:transparent;color:var(--dark)}
.navbtn:hover,.navbtn.active{background:#E3EBDD}
button:hover{transform:translateY(-2px);filter:brightness(.97)}
.primary{background:var(--dark);color:white}
.secondary{background:#E4EBD9;color:var(--dark)}
main{min-height:70vh}
.page{display:none;max-width:1120px;margin:auto;padding:42px 6% 70px}
.page.active{display:block;animation:fade .3s}
@keyframes fade{from{opacity:.3;transform:translateY(5px)}to{opacity:1;transform:none}}
.hero{
  background:linear-gradient(130deg,#E3EBDD,#F8F1E3);
  border-radius:28px;padding:48px 7%;position:relative;overflow:hidden
}
.hero:after{
  content:"❋";position:absolute;right:5%;top:0;
  font-size:180px;color:#79543A15;pointer-events:none
}
.eyebrow{color:var(--brown);font-weight:bold;letter-spacing:2px}
h1,h2,h3{line-height:1.25;color:var(--dark)}
h1{font-size:clamp(38px,7vw,68px);margin:10px 0}
h2{font-size:clamp(25px,4vw,36px)}
h3{margin-top:8px}
.hero p{max-width:600px}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}
.section-head{text-align:center;margin:10px 0 30px}
.section-head p{max-width:650px;margin:10px auto;color:#716451}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.card{
  background:var(--white);padding:22px;border-radius:18px;
  border:1px solid #E7DDCB;box-shadow:0 5px 18px #59462a0a
}
.card .symbol{font-size:30px}
.card p{font-size:14px}
.muted{color:#766A59;font-size:13px}
.pill{display:inline-block;background:#E3EBDD;color:var(--dark);
  padding:4px 10px;border-radius:20px;font-size:12px}
.callout{background:#E3EBDD;border-radius:18px;padding:22px;margin:25px 0}
footer{text-align:center;background:var(--dark);color:#F8F1E3;padding:28px 15px}
footer small{opacity:.85}
button:focus-visible,.navbtn:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
#regions{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:20px 0}
.region{
  background:#E3EBDD;color:var(--dark);padding:16px 10px;
  border:2px solid transparent;border-radius:15px
}
.region.selected{border-color:var(--brown);background:#D5E2CC}
.batik-card{display:flex;flex-direction:column;gap:8px}
.batik-card button{margin-top:auto;align-self:flex-start}
.detail{margin-top:25px;border:2px solid var(--gold)}
.detail dl{display:grid;grid-template-columns:130px 1fr;gap:10px;font-size:14px}
.detail dt{font-weight:bold;color:var(--brown)}
.detail dd{margin:0}
.quiz-option{
  display:block;width:100%;text-align:left;margin:9px 0;
  background:#F0E8D9;color:#443B30;border:2px solid transparent
}
.quiz-option:hover{border-color:var(--green)}
.quiz-option:disabled{cursor:default;transform:none}
.feedback{font-weight:bold;margin-top:12px}
.progress{height:8px;background:#E5DCCB;border-radius:8px;overflow:hidden}
.progress span{display:block;height:100%;background:var(--green);width:0;transition:.3s}
.style-tabs{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
.style-tabs button.selected{background:var(--dark);color:white}
.map-note{font-size:13px;color:#766A59}
@media(max-width:600px){
 header{position:relative;padding:12px 4%}
 nav{width:100%}
 .navbtn{padding:8px;font-size:12px;flex:1}
 .page{padding:25px 5% 45px}
 .hero{padding:32px 7%}
 .detail dl{grid-template-columns:1fr;gap:3px}
 .detail dd{margin-bottom:12px}
}
</style>
</head>
